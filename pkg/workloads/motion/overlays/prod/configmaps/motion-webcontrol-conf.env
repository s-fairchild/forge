# shellcheck shell=bash
# shellcheck disable=all

# https://motion-project.github.io/motionv5_config.html#OptDetail_Webcontrol

# https://motion-project.github.io/motionv5_config.html#webcontrol_localhost
LOCALHOST=off

# https://motion-project.github.io/motionv5_config.html#webcontrol_auth_method
AUTH_METHOD=digest

# https://motion-project.github.io/motionv5_config.html#webcontrol_actions
ACTIONS_MOVIES=on

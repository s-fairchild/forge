---
# https://coreos.github.io/coreos-installer/customizing-install/#example-manual-customization-via-installerd
variant: fcos
version: 1.5.0
ignition:
  config:
    merge:
    - local: base/coreos-installer/install.ign.gz
      compression: gzip
storage:
  trees:
  - path: /etc/coreos/installer.d/custom-config.yaml
    local: overlays/prod/coreos-installer/etc/coreos/installer.d

# deploy/butane/overlays/prod/etc-containers-secrets.bu
#
# Installs the pre-generated podman file secret driver database (secretsdata.json)
# into /var/lib/containers/storage/secrets/filedriver/ on the node.
#
# This file is produced by hack/bin/k3s-tokens-generate.sh and contains the k3s
# cluster authentication tokens (k3s-token, k3s-agent-token) in the format expected
# by the podman file secret driver.  Installing it via ignition pre-populates the
# podman secret store so that the k3s container units can reference the secrets
# via `Secret=k3s-token` without requiring a separate `podman secret create` step
# on the live node.
#
# The sha512 verification hash must be updated whenever the secretsdata.json is
# regenerated. See deploy/butane/overlays/prod/secrets.env for the source files.
---
variant: fcos
version: 1.7.0
storage:
  files:
    - path: /var/lib/containers/storage/secrets/filedriver/secretsdata.json
      overwrite: true
      contents:
        source: https://10.50.0.202:8080/secrets/prod-secretsdata.json
        # TODO find way to get reliable hash values from podman secret inspect locally
        # podman secret inspect --showsecret | jq -r provides differing hash values
        # possibly gzip?
        verification:
          hash: sha512-898738f2acad652e7b6239882b0ccb9cc8b130ca30e6b37568883767064aef67bb19bada9c813ecc5a57fca91ebe5d2b425041f0cb4e751cf8ae10a903fa7b5f
      mode: 0600
      user:
        name: root
      group:
        name: root

    - path: /var/lib/containers/storage/secrets/secrets.json
      overwrite: true
      contents:
        source: https://10.50.0.202:8080/secrets/prod-secrets.json
        # TODO find way to get reliable hash values from podman secret inspect locally
        # podman secret inspect --showsecret | jq -r provides differing hash values
        # possibly gzip?
        verification:
          hash: sha512-6621e50917ba1a998377a74352043e4bf4fa2220ccabfd2ab7af9297ad1c7f981797ca7f854c42e6dccd3d8face2cec156a6e439a9d458407643029e7f929e6a
      mode: 0600
      user:
        name: root
      group:
        name: root

---
variant: fcos
version: 1.5.0
storage:
  directories:
  - path: /etc/NetworkManager/system-connections
    overwrite: true

  # TODO Load via nmstate file
  files:
  - path: /etc/NetworkManager/system-connections/Production.nmconnection
    overwrite: true
    # Must not have other permissions, or NetworkManager refuses to load it.
    mode: 0600
    user:
      name: root
    group:
      name: root
    contents:
      local: NetworkManager/system-connections/Production.nmconnection

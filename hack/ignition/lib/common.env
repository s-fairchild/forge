# shellcheck shell=bash

# declare -r __ignition_common_sourced="true"
declare -r __ignition_common_lib_sourced="true"

if [ "${__ignition_utils_sourced:-false}" == "false" ]; then
    # declare -r __ignition_utils_lib="hack/ignition/lib/utils.sh"
    declare -r __ignition_utils_lib="hack/ignition/lib/utils.sh"
    [ -f "$__ignition_utils_lib" ] || fatal --status=5 "$__ignition_utils_lib file not found"

    # shellcheck source=utils.sh
    . "$__ignition_utils_lib"
fi

if [ "${__ignition_constants_sourced:-false}" == "false" ]; then
    # declare -r __constants="hack/ignition/lib/constants.env"
    declare -r __ignition_constants_lib="hack/ignition/lib/constants.env"
    [ -f "$__ignition_constants_lib" ] || fatal --status=5 "$__ignition_constants_lib file not found."

    # shellcheck source=constants.env
    . "$__ignition_constants_lib"
fi

if [ "${__ignition_sourced:-false}" == "false" ]; then
    # declare -r __ignition_lib="hack/ignition/lib/ignition.sh"
    declare -r __ignition_lib="hack/ignition/lib/ignition.sh"
    [ -f "$__ignition_lib" ] || fatal --status=5 "$__ignition_lib file not found."

    # shellcheck source=ignition.sh
     . "$__ignition_lib"
fi

if [ "${__ignition_butane_sourced:-false}" == "false" ]; then
    # declare __ignition_butane_lib="hack/ignition/lib/butane.sh"
    declare __ignition_butane_lib="hack/ignition/lib/butane.sh"
    [ -f "$__ignition_butane_lib" ] || fatal --status=5 "$__ignition_butane_lib file not found."

    # shellcheck source=butane.sh
    . "$__ignition_butane_lib"
fi

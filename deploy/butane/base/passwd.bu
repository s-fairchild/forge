---
variant: fcos
version: 1.7.0
passwd:
  users:
    - name: localpath
      uid: 511
      gecos: localpath Kubernetes Volume Provisioner System User
      no_create_home: true
      shell: /sbin/nologin
      system: true

storage:
  directories:
    - path: /root/.bashrc.d
      overwrite: true

  trees:
    - path: /root/.bashrc.d
      local: root/bashrc.d

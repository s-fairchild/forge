[Unit]
Documentation=https://docs.k3s.io/ https://github.com/k3s-io/k3s/blob/main/README.md

[Service]
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=150
ExecStartPre=modprobe iptable_filter
ExecStartPre=modprobe iptable_nat
ExecStartPre=/usr/bin/podman secret exists k3s-token
ExecStartPre=/usr/bin/podman secret exists k3s-agent-token
Environment="NAME=%p-%i"
EnvironmentFile=-/usr/local/etc/sysconfig/%p
EnvironmentFile=-/usr/local/etc/sysconfig/%p-%i

[Container]
StopTimeout=120
HealthCmd=wget -qO- http://localhost:10248/healthz
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
ContainerName=${NAME}
HostName=${NAME}
Label="app=k3s"
DNSSearch=expresso.lan
Timezone=UTC
Pull=never
LogDriver=journald
Image=k3s@v1.36.1-k3s1.image
EnvironmentFile=-/usr/local/etc/sysconfig/%N
# K3S configuration via environment
# https://docs.k3s.io/cli/server#cluster-options
Environment="K3S_NODE_NAME=${NAME}"
Environment="K3S_TOKEN_FILE=/run/secrets/k3s-token"
PodmanArgs=--oom-score-adj=-500 --privileged
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=${NAME}-kubelet:/var/lib/kubelet:Z,rslave
Volume=${NAME}-pod-logs:/var/log/pods:Z,rslave
Volume=${NAME}-data:/var/lib/rancher/k3s:Z,rslave
Volume=${NAME}-rancher:/etc/rancher,rslave
Volume=local-path@default.volume:/mnt/local-path/default:z,rshared
Volume=/usr/local/lib/rancher/k3s/server/manifests/custom:/var/lib/rancher/k3s/server/manifests/custom:z

[Install]
WantedBy=default.target

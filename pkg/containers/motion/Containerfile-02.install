FROM builder AS build

ARG MOTION_VERSION

ARG MOTION_SOURCE=/tmp/motion
ADD https://github.com/Motion-Project/motion.git#${MOTION_VERSION} ${MOTION_SOURCE}
WORKDIR ${MOTION_SOURCE}

ARG BUILD_THREADS
ARG INSTALL_PREFIX

RUN autoreconf -fiv \
    && ./configure --prefix=${INSTALL_PREFIX} \
    && make -j${BUILD_THREADS} \
    && make install

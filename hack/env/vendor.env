# hack/env/vendor.env
#
# shellcheck shell=bash

[ "${XTRACE:-0}" -eq 1 ] && set -x

declare -r __hack_env_vendor_sourced="true"

declare -rx VENDOR_DIR="hack/vendor"
declare -ax MAPFILE=()
mapfile -d '' -t < <(find "$VENDOR_DIR" \
                          -mindepth 1 \
                          -maxdepth 1 \
                          -type d)

declare -A VENDOR_GIT_MODULES=()
# shellcheck disable=SC2068
for m in ${MAPFILE[@]}; do
    VENDOR_GIT_MODULES+=(["$(basename "$m")"]="$m")
done
unset MAPFILE

declare -rx VENDOR_GIT_MODULES

declare -F fatal > /dev/null 2>&1 || fatal() { printf '%s\n' "${1:-}" >&2; exit 1; }

if [ "${__bash_utils_base_config_logging_sourced:-}" != "true" ]; then
    declare __bash_utils_base_config_logging="${VENDOR_GIT_MODULES[bash-utils]}/lib/base-config-logging.sh"
    [ -f "$__bash_utils_base_config_logging" ] || fatal "file not found: $__bash_utils_base_config_logging"
    # shellcheck source=../vendor/bash-utils/lib/base-config-logging.sh
    . "$__bash_utils_base_config_logging"
    unset __bash_utils_base_config_logging
fi

if [ "${__bashkit_lib_logging_sourced:-}" != "true" ]; then
    declare __bashkit_lib_logging="${VENDOR_GIT_MODULES[bashkit]}/lib/logging.sh"
    [ -f "$__bashkit_lib_logging" ] || fatal "file not found: $__bashkit_lib_logging"
    # shellcheck source=../vendor/bashkit/lib/logging.sh
    . "$__bashkit_lib_logging"
    unset __bashkit_lib_logging
fi

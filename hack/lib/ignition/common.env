# shellcheck shell=bash

# declare -r __ignition_common_sourced="true"
declare -r __ignition_common_lib_sourced="true"

if [ "${__lib_opt_bash_utils_logging_sourced:-}" != "true" ]; then
    # declare -r __lib_opt_bash_utils_logging="hack/lib/opt-bash-utils-logging.sh"
    declare -r __lib_opt_bash_utils_logging="hack/lib/opt-bash-utils-logging.sh"

    [ -f "$__lib_opt_bash_utils_logging" ] || eval "$(echo "$__lib_opt_bash_utils_logging file not found"; exit 5)"
    # shellcheck source=../../lib/opt-bash-utils-logging.sh
    . "$__lib_opt_bash_utils_logging"
fi

if [ "${__ignition_utils_sourced:-}" != "true" ]; then
    # declare -r __ignition_utils_lib="hack/lib/ignition/utils.sh"
    declare -r __ignition_utils_lib="hack/lib/ignition/utils.sh"

    [ -f "$__ignition_utils_lib" ] || fatal --status=5 "$__ignition_utils_lib file not found"
    # shellcheck source=utils.sh
    . "$__ignition_utils_lib"
fi

if [ "${__ignition_constants_sourced:-}" != "true" ]; then
    # declare -r __ignition_constants_lib="hack/lib/ignition/constants.env"
    declare -r __ignition_constants_lib="hack/lib/ignition/constants.env"

    [ -f "$__ignition_constants_lib" ] || fatal --status=5 "$__ignition_constants_lib file not found."
    # shellcheck source=constants.env
    . "$__ignition_constants_lib"
fi

if [ "${__ignition_sourced:-}" != "true" ]; then
    # declare -r __ignition_lib="hack/lib/ignition/ignition.sh"
    declare -r __ignition_lib="hack/lib/ignition/ignition.sh"

    [ -f "$__ignition_lib" ] || fatal --status=5 "$__ignition_lib file not found."
    # shellcheck source=ignition.sh
     . "$__ignition_lib"
fi

if [ "${__ignition_butane_sourced:-}" != "true" ]; then
    # declare __ignition_butane_lib="hack/lib/ignition/butane.sh"
    declare __ignition_butane_lib="hack/lib/ignition/butane.sh"

    [ -f "$__ignition_butane_lib" ] || fatal --status=5 "$__ignition_butane_lib file not found."
    # shellcheck source=butane.sh
    . "$__ignition_butane_lib"
fi

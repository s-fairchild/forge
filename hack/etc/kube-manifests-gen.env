# Environment file for generate_kube_manifests
# shellcheck shell=bash disable=SC2034

[ "${XTRACE:-0}" -eq 1 ] && set -x

[[ -v __manifest_out_extension ]] \
  || readonly __manifest_out_extension=".yaml"

# apps is populated (via mapfile) with directories found in paths:
#   * pkg/workloads
#   * pkg/operators.
#
# Notes:
#   * apps is declared as global here to account for import (defined in hack/vendor/bashkit) sourcing this file.
#     import is a function. Therefore we must explicitly declare them as global.
#   * apps and apps_enabled are only defined the first time this file is sourced, so sourcing it
#     again changes nothing. `declare -p` rather than `[[ -v ]]`, which is false for an empty array.
if ! declare -p apps >/dev/null 2>&1; then
  declare -ga apps=()

  mapfile -d '' -t apps < <(find pkg/workloads \
      pkg/operators \
      -mindepth 1 \
      -maxdepth 1 \
      -type d \
      -print0)
  readonly apps
fi

# apps_enabled is a list of explicitly enabled kubernetes applications.
# Applications in this array will have manifests built via kustomize.
#
# Notes:
#   * indexes can be unset for disabling specific application builds for specific environments (base, staging, prod, etc...)
#   * apps_enabled is declared as global here to account for import (defined in hack/vendor/bashkit) sourcing this file.
#     import is a function. Therefore we must explicitly declare them as global.
#   * Sourcing this file again keeps any indexes a script unset.
declare -p apps_enabled >/dev/null 2>&1 || declare -ga apps_enabled=(
    #################
    ### Operators ###
    #################
    "cert-manager"
    "coredns-custom"
    "intel-device-plugins-gpu"
    "intel-device-plugins-operator"
    "kube-vip"
    "local-path-provisioner"
    "mariadb-operator"
    "mariadb-operator-crds"
    "node-feature-discovery"
    "traefik-custom"

    #################
    ### Workloads ###
    #################
    # "fcos-vm"
    "jellyfin"
    "mariadb-cluster"
    "motion"
    # "pihole"
    "v4l2rtspserver"
)

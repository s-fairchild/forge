---
variant: fcos
version: 1.5.0
storage:
  links:
    - path: /etc/containers/systemd/local-path@default.volume
      overwrite: true
      target: /etc/containers/systemd/local-path@.volume
    - path: /etc/containers/systemd/local-path@appdata.volume
      overwrite: true
      target: /etc/containers/systemd/local-path@.volume
    - path: /etc/containers/systemd/local-path@cctv.volume
      overwrite: true
      target: /etc/containers/systemd/local-path@.volume

  directories:
    - path: /etc/containers/systemd/local-path@default.volume.d
      overwrite: true
    - path: /etc/containers/systemd/local-path@appdata.volume.d
      overwrite: true
    - path: /etc/containers/systemd/local-path@cctv.volume.d
      overwrite: true
  trees:
    - path: /etc/containers/systemd/local-path@default.volume.d
      local: butane/overlays/prod/podman/volumes/local-path@default.volume.d
    - path: /etc/containers/systemd/local-path@appdata.volume.d
      local: butane/overlays/prod/podman/volumes/local-path@appdata.volume.d
    - path: /etc/containers/systemd/local-path@cctv.volume.d
      local: butane/overlays/prod/podman/volumes/local-path@cctv.volume.d

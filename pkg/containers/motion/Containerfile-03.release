ARG IMAGE_REGISTRY
ARG IMAGE_REPOSITORY
ARG IMAGE_TAG
FROM ${IMAGE_REGISTRY}/${IMAGE_REPOSITORY}:${IMAGE_TAG} AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
      DEBIAN_FRONTEND=noninteractive apt-get update \
      && DEBIAN_FRONTEND=noninteractive apt-get upgrade \
      && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
            # FFmpeg required shared libraries
            libxcb1 libxcb-shm0 libasound2t64 libsndio7.0 libsdl2-2.0-0 libxv1 libva-drm2 \
            libzimg2 ocl-icd-libopencl1 libmfx-gen1.2 libvpx9 libwebpmux3 libzvbi0t64 \
            libtwolame0 libx264-164 libx265-215 libxvidcore4 libva-x11-2 \
            # Motion required shared libraries
            libjpeg-tools libmicrohttpd12t64 libsqlite3-0

ARG PREFIX
ARG FFMPEG
# --from=${FFMPEG} is an image reference added via --build-context
COPY --from=${FFMPEG} \
    --link \
        ${PREFIX}/bin ${PREFIX}/bin
COPY --from=${FFMPEG} \
    --link \
        ${PREFIX}/lib ${PREFIX}/lib

# https://motion-project.github.io/motion_build.html#Make_Install
# --from=motion here is a stage reference
COPY --from=motion \
    --link \
        ${PREFIX}/bin/motion ${PREFIX}/bin/motion
COPY --from=motion \
    --link \
        ${PREFIX}/etc/motion ${PREFIX}/etc/motion

ARG MAKE_OPTIONS_EXCLUDE
ARG MAKE_FLAGS
ARG MOTION_VERSION

LABEL motion.make.options-exclude="${MAKE_OPTIONS_EXCLUDE}"
LABEL motion.make.flags="${MAKE_FLAGS}"
LABEL motion.version="${MOTION_VERSION}"

ENV LD_LIBRARY_PATH="$PREFIX/lib"
ENTRYPOINT [ "motion" ]

[Unit]
Description=K3S Application Loadbalancer Node %i Podman Container

[Service]
Restart=always
RestartSec=30
ExecStartPre=modprobe iptable_filter
ExecStartPre=modprobe iptable_nat
ExecStartPre=/usr/bin/podman secret exists k3s-token
Environment="NAME=k3s-svclb-%i"
EnvironmentFile=/usr/local/etc/sysconfig/podman-options
EnvironmentFile=/usr/local/etc/sysconfig/k3s-image

[Container]
ContainerName=${NAME}
HostName=${NAME}
Label=app=k3s
Label=role=loadbalancer
Label=cluster=${CLUSTER}
Image=k3s.image
DNSSearch=${DNS_SEARCH}
Pull=never
ShmSize=5g
Timezone=UTC
LogDriver=journald
EnvironmentFile=/usr/local/etc/sysconfig/k3s
Environment=K3S_TOKEN_FILE=/run/secrets/k3s-token
Secret=k3s-token,mode=0400
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=${NAME}-data:/var/lib/rancher/k3s:Z,rslave
Volume=${NAME}-rancher:/etc/rancher:Z,rslave
Volume=${NAME}-kubelet:/var/lib/kubelet:Z,rslave
Volume=${NAME}-pod-logs:/var/log/pods:Z,rslave
Volume=${NAME}-data:/var/lib/rancher/k3s:Z,rslave
Volume=/usr/local/etc/k3s:/etc/rancher/k3s/config.yaml,Z,ro
PodmanArgs=--oom-score-adj=1000 --privileged

[Install]
WantedBy=default.target

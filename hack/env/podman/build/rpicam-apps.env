# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r RPICAM_APPS_VERSION="RPICAM_APPS_VERSION"
#
# podman build-arg constant
declare -r RPICAM_APPS_VERSION="RPICAM_APPS_VERSION"

# declare -r RPICAM_APPS_VERSION_TAG_DEFAULT='v1.11.1'
#
# References:
#   * https://github.com/raspberrypi/rpicam-apps/releases/tag/v1.11.1
#   * https://github.com/raspberrypi/rpicam-apps/tree/v1.11.1
declare -r RPICAM_APPS_VERSION_TAG_DEFAULT='v1.11.1'
echo "RPICAM_APPS_VERSION_TAG_DEFAULT=${RPICAM_APPS_VERSION_TAG_DEFAULT}"

if [ -v RPICAM_APPS_VERSION_TAG_OVERRIDE ]; then
    echo "RPICAM_APPS_VERSION_TAG_OVERRIDE=${RPICAM_APPS_VERSION_TAG_OVERRIDE}"
else
    echo "RPICAM_APPS_VERSION_TAG_DEFAULT can be overridden by setting RPICAM_APPS_VERSION_TAG_OVERRIDE"
fi

# declare -r RPICAM_APPS_VERSION_TAG="${RPICAM_APPS_VERSION_TAG_OVERRIDE:=${RPICAM_APPS_VERSION_TAG_DEFAULT}}"
#
# RPICAM_APPS_VERSION_TAG can be overridden by setting RPICAM_APPS_VERSION_TAG_OVERRIDE
declare -r RPICAM_APPS_VERSION_TAG="${RPICAM_APPS_VERSION_TAG_OVERRIDE:-${RPICAM_APPS_VERSION_TAG_DEFAULT}}"

# declare -A BUILD_ARGS=(
#   ["$RPICAM_APPS_VERSION"]="$RPICAM_APPS_VERSION_TAG"
#   # Used to reference libcamera build context in --from=libcamera
#   # ARG LIBCAMERA=libcamera
#   # See BUILD_CONTEXTS
#   ["${IMAGE_LIBCAMERA^^}"]="$IMAGE_LIBCAMERA"
# )
#
# An associative array is used for buildargs to allow adding them as options without knowing the keys
# key=build-arg, value=build-arg value
#
# References:
#   * https://github.com/raspberrypi/libcamera/releases/tag/v0.6.0%2Brpt20251202
#   * https://github.com/raspberrypi/libcamera/tree/v0.6.0%2Brpt20251202
declare -A BUILD_ARGS=(
    ["$RPICAM_APPS_VERSION"]="$RPICAM_APPS_VERSION_TAG"
    # Used to reference libcamera build context in --from=libcamera
    # ARG LIBCAMERA=libcamera
    # See BUILD_CONTEXTS
    ["${IMAGE_LIBCAMERA^^}"]="$IMAGE_LIBCAMERA"
)

# declare -A BUILD_CONTEXTS=(
#   ["$IMAGE_LIBCAMERA"]="${CONTEXT_CONTAINER_IMAGE}${LOCAL_REPOSITORY}/${IMAGE_LIBCAMERA}:${IMAGE_TAG_LATEST}"
# )
declare -A BUILD_CONTEXTS=(
    ["$IMAGE_LIBCAMERA"]="${CONTEXT_CONTAINER_IMAGE}${LOCAL_REPOSITORY}/${IMAGE_LIBCAMERA}:${IMAGE_TAG_LATEST}"
)

# declare -r constants="hack/lib/podman/build/constants.env"
declare -r constants="hack/lib/podman/build/constants.env"
[ -f "$constants" ] || "$(echo "File not found: $constants. Exiting."; exit 1)"

# This is here so that shellcheck can resolve variables within vscode.
# The values are already present in the upper scope when this file is sourced.
# To prevent readonly variables from beind reset causing an error, a known value is checked before sourcing would occur.
if [ -z "${IMAGE_TAG_LATEST}" ]; then
    # shellcheck source=../../../lib/podman/build/constants.env
    source "$constants"
fi

# declare -r IMAGE_TAG_PRIMARY="$RPICAM_APPS_VERSION_TAG"
#
# Used to set --tag passed to podman build, which should be the app version.
#   * This generic variable is set so that the app version can be set as the final image build tag without knowing what the image is.
#   * This is simpler and safer than using the last value in an array of tags.
#   * Additional tags will be created in later steps.
declare -r IMAGE_TAG_PRIMARY="$RPICAM_APPS_VERSION_TAG"
echo "IMAGE_TAG_PRIMARY=${IMAGE_TAG_PRIMARY}"

# Just to be safe (or pedantic), IMAGE_TAGS should be declared after the pseudo source (constants.env should have already been sourced by now).

# declare -a IMAGE_TAGS=(
#   "$IMAGE_TAG_LATEST"
#   "$RPICAM_APPS_VERSION_TAG"
# )
#
# All tags are added to an array to allow passing to skopeo all at once
declare -a IMAGE_TAGS=(
    "$IMAGE_TAG_LATEST"
    "$RPICAM_APPS_VERSION_TAG"
)

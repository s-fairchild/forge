ARG IMAGE_REGISTRY
ARG IMAGE_REPOSITORY
ARG IMAGE_TAG
FROM --platform=${BUILDPLATFORM} ${IMAGE_REGISTRY}/${IMAGE_REPOSITORY}:${IMAGE_TAG} AS base

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
        DEBIAN_FRONTEND=noninteractive \
        apt-get update \
        && apt-get install --no-install-recommends -y \
            ffmpeg libmfx-dev \
        && DEBIAN_FRONTEND=noninteractive \
        # Install motion v5 build dependencies
        # https://motion-project.github.io/motionv5_build.html#Building_Guide
        apt-get install --no-install-recommends -y \
            # Used to set timezone in release stage
            tzdata \
            # Build tools
            autoconf automake autopoint build-essential pkgconf libtool git gettext \
            # FFMpeg Functionality(Required for creating movies, using network cameras, etc.)
            libzip-dev libjpeg-dev libavformat-dev libavcodec-dev libavutil-dev libswscale-dev \
            # opencv
            libopencv-dev \
            # Web Interface
            libwebp-dev libmicrohttpd-dev \
            # Alsa sound dependencies
            libasound2-dev libpulse-dev libfftw3-dev libavdevice-dev \
            # libcamera (Raspberry Pi Cam)
            libcamera-v4l2 libcamera-dev libcamera-tools \
            # Database dependencies
            #
            # SQLite3 database functionality
            libsqlite3-dev \
            # MariaDB database functionality
            libmariadb-dev \
            # MySQL database functionality
            #
            # Package conflict currently exists. Skipping this in favor of mariadb
            # libmysqlclient-dev default-libmysqlclient-dev \
            # PostgreSQL database functionality
            libpq-dev 

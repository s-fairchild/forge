# shellcheck shell=bash
# shellcheck disable=all
#
# Output - Movie Options
# Reference: https://motion-project.github.io/motionv5_config.html#OptDetail_Movies

# https://motion-project.github.io/motionv5_config.html#movie_output
OUTPUT=off

# https://motion-project.github.io/motionv5_config.html#movie_max_time
# MAX_TIME=120

# https://motion-project.github.io/motionv5_config.html#movie_quality
# QUALITY=100

# https://motion-project.github.io/motionv5_config.html#movie_container
# CONTAINER=mkv

# https://motion-project.github.io/motionv5_config.html#movie_filename
FILENAME=%t-%v-%Y%m%d%H%M%S

# https://motion-project.github.io/motionv5_config.html#movie_retain
# RETAIN=off

# PASSTHROUGH=off

# Use to encode video in a sidecar container
# EXTPIPE_USE=off

# Determine if this is for pictures saved or videos
# TIMELAPSE_INTERVAL=0
# TIMELAPSE_MODE=daily
# TIMELAPSE_FPS=30
TIMELAPSE_FILENAME=%t-%v-%Y%m%d%H%M%S-timelapse

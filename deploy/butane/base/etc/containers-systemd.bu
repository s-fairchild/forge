---
variant: fcos
version: 1.5.0
storage:
  directories:
  - path: /etc/containers/systemd
    overwrite: true

  trees:
  - path: /etc/containers
    local: containers/systemd

  links:
  ######################
  ####### Images #######
  ######################
  - path: /etc/containers/systemd/k3s@stable.image
    target: /etc/containers/systemd/k3s@.image
    overwrite: true

  ######################
  ###### Networks ######
  ######################
  - path: /etc/containers/systemd/k3s@agent.network
    target: /etc/containers/systemd/k3s@.network
    overwrite: true

  ######################
  ###### Volumes #######
  ######################
  - path: /etc/containers/systemd/local-path@default.volume
    target: /etc/containers/systemd/local-path@.volume
    overwrite: true

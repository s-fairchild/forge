# hack/env/vendor.env
#
# shellcheck shell=bash

declare -r VENDOR_DIR="hack/vendor"
declare -a MAPFILE=()
mapfile -d '' -t < <(find "$VENDOR_DIR" \
                          -mindepth 1 \
                          -maxdepth 1 \
                          -type d)

declare -A VENDOR_GIT_SUBMODULES=()
# shellcheck disable=SC2068
for m in ${MAPFILE[@]}; do
    VENDOR_GIT_SUBMODULES+=(["$(basename "$m")"]="$m")
done
unset MAPFILE

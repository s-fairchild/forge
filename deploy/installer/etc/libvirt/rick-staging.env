# deploy/installer/etc/libvirt/rick-staging.env
#
# Per-domain libvirt object names and XML template directory for the rick-staging
# dev VM. Consumed by deploy/installer/Makefile's install-staging-vm target and
# passed through to hack/bin/ensure-staging-vm.sh's -l/-n/-p/-d/-m/-s options.
# shellcheck shell=bash disable=SC2034

declare -r __env_libvirt_rick_staging_sourced="true"

# qemu:///session (the default when unset) cannot create the bridged NAT network
# in network.xml -- creating a host bridge device requires privileges session-mode
# libvirt doesn't have. Exported so it's visible to ensure-staging-vm.sh's virsh
# calls, which run in a separate process from the Makefile recipe's shell.
declare -rx LIBVIRT_DEFAULT_URI="qemu:///system"

declare -r LIBVIRT_DIR="deploy/libvirt/staging"
declare -r NETWORK_NAME="staging"
declare -r POOL_NAME="fcos-staging"
declare -r VOLUME_NAME="rick-staging.qcow2"
declare -r DOMAIN_NAME="rick-staging"
declare -r IGNITION_SECRET="ignition-staging"

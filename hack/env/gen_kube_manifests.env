# shellcheck shell=bash
# Environment file for generate_kube_manifests
# shellcheck disable=SC2034

### Cluster Operators ###

# declare -r skip_coredns_custom="coredns-custom"
declare -r skip_coredns_custom="coredns-custom"

# declare -r skip_local_path_custom="local-storage-custom"
declare -r skip_local_path_custom="local-storage-custom"

# declare -r skip_traefik_custom="traefik-custom"
declare -r skip_traefik_custom="traefik-custom"

# declare -r skip_cloudnative_pg="cloudnative-pg"
declare -r skip_cloudnative_pg="cloudnative-pg"

# declare  -r skip_mariadb_operator_crds="mariadb-operator-crds"
declare  -r skip_mariadb_operator_crds="mariadb-operator-crds"

# declare  -r skip_mariadb_operator="mariadb-operator"
declare  -r skip_mariadb_operator="mariadb-operator"

### Workloads ###

# declare -r skip_jellyfin="jellyfin"
declare -r skip_jellyfin="jellyfin"

# declare -r skip_motion="motion"
declare -r skip_motion="motion"

# declare -r skip_pihole="pihole"
declare -r skip_pihole="pihole"

# declare -r skip_v4l2rtspserver="v4l2rtspserver"
declare -r skip_v4l2rtspserver="v4l2rtspserver"

# declare -r skip_cloudnative_pg_cluster="cloudnative-pg-cluster"
declare -r skip_cloudnative_pg_cluster="cloudnative-pg-cluster"

# declare -r skip_mariadb_cluster="mariadb-cluster"
declare -r skip_mariadb_cluster="mariadb-cluster"

# declare -r disabled_pkgs="($skip_pihole|$skip_coredns_custom)"
declare -r disabled_pkgs="($skip_pihole|$skip_coredns_custom|$skip_cloudnative_pg|$skip_cloudnative_pg_cluster)"

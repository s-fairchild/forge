# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r __ignition_constants_sourced="true"
declare -r __ignition_constants_sourced="true"

# declare -r BUTANE_FILE_EXTENSION=".bu"
declare -r BUTANE_FILE_EXTENSION=".bu"

# declare -r IGNITION_FILE_EXTENSION=".ign"
declare -r IGNITION_FILE_EXTENSION=".ign"

# declare -r source_error_suffix="not found. Are you in the repository root?"
declare -r ERROR_SOURCE_SUFFIX="not found. Are you in the repository root?"

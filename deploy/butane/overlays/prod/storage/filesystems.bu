---
variant: fcos
version: 1.5.0
storage:
  filesystems:
  - device: /dev/mapper/root
    format: btrfs
    wipe_filesystem: true
    label: root
    mount_options:
      - compress=zstd:3
      - x-systemd.device-timeout=0
      - discard=async
      - ssd

  - device: /dev/mapper/var
    path: /var
    format: btrfs
    wipe_filesystem: true
    with_mount_unit: true
    label: var
    mount_options:
      - compress=zstd:3
      - x-systemd.device-timeout=0
      - discard=async
      - ssd

  - device: /dev/mapper/appdata
    path: /mnt/appdata
    format: btrfs
    wipe_filesystem: true
    with_mount_unit: false
    label: appdata
    mount_options:
      - compress=zstd:3
      - x-systemd.device-timeout=0
      - discard=async

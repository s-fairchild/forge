ARG IMAGE_REGISTRY
ARG IMAGE_REPOSITORY
ARG IMAGE_TAG
FROM --platform=${BUILDPLATFORM} ${IMAGE_REGISTRY}/${IMAGE_REPOSITORY}:${IMAGE_TAG} AS release

ARG TZ
ENV TZ=${TZ}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
        # The packages being installed want to know the timezone.
        echo "$TZ" > /etc/timezone \
        # Update everything
        && DEBIAN_FRONTEND=noninteractive \
          apt-get update \
          && apt-get upgrade -y \
        && DEBIAN_FRONTEND=noninteractive \
          apt-get install --no-install-recommends -y \
            # ffmpeg required shared libraries
            libxcb1 libxcb-shm0 libasound2t64 libsndio7.0 libsdl2-2.0-0 libxv1 \
            libzimg2 ocl-icd-libopencl1 libvpx9 libwebpmux3 libzvbi0t64 \
            libtwolame0 libx264-164 libx265-199 libxvidcore4 libfftw3-bin \
            # https://github.com/Intel-Media-SDK/MediaSDK/wiki/Intel-media-stack-on-Ubuntu#runtime-environment
            # https://github.com/Intel-Media-SDK/MediaSDK/wiki/Intel-media-stack-on-Ubuntu#available-drivers
            # Intel QSV Runtime drivers
            libmfx1 libmfx-tools libva-drm2 i965-va-driver intel-media-va-driver \
            libva-x11-2 libva-drm2 \
            # motion runtime dependencies
            libmicrohttpd12t64 libcamera0.2 libopencv-objdetect406t64 \
            libopencv-imgcodecs406t64 libmariadb3 libavutil58 \
            libavformat60 libswscale7 libavdevice60

ARG PREFIX

COPY --from=builder "$PREFIX/var/lib/motion" "$PREFIX/var/lib/motion"
COPY --from=builder "$PREFIX/bin/motion" "$PREFIX/bin/motion"
COPY --from=builder "$PREFIX/share/locale" "$PREFIX/share/locale"
COPY --from=builder "/usr/share/zoneinfo/$TZ" /etc/localtime 

ARG FFMPEG_VERSION

COPY --from=docker.io/steve51516/ffmpeg:${FFMPEG_VERSION} \
    "$PREFIX/bin/ffmpeg" \
    "$PREFIX/bin/ffmpeg"
COPY --from=docker.io/steve51516/ffmpeg:${FFMPEG_VERSION} \
    --exclude=$PREFIX/lib/pkgconfig \
    "$PREFIX/lib" \
    "$PREFIX/lib"

ARG LIBVA_DRIVER_NAME
ARG MOTION_VERSION

LABEL motion.build.prefix=${PREFIX}
LABEL motion.version=${MOTION_VERSION}
LABEL ffmpeg.version=${FFMPEG_VERSION}
LABEL system.timezone=${TZ}
LABEL system.libva.driver.name=${LIBVA_DRIVER_NAME}

ENV LIBVA_DRIVER_NAME=${LIBVA_DRIVER_NAME}
ENV LD_LIBRARY_PATH="$PREFIX/lib"

ENTRYPOINT [ "motion" ]

---
variant: fcos
version: 1.7.0
storage:
  filesystems:
  - device: /dev/disk/by-partlabel/root
    format: btrfs
    wipe_filesystem: true
    label: root
    mount_options:
      - compress=zstd:3
      - x-systemd.device-timeout=0
      - barrier
      - datasum
      - rescue=usebackuproot
      - discard=async

  - device: /dev/mapper/var
    path: /var
    format: btrfs
    with_mount_unit: true
    label: var
    mount_options:
      - compress=zstd:3
      - x-systemd.device-timeout=0
      - barrier
      - datasum
      - rescue=usebackuproot
      - discard=async

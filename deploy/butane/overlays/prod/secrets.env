# deploy/butane/overlays/prod/main.env
#
# shellcheck shell=bash
# shellcheck disable=SC2034

declare -ar SECRET_KEYS=(
    # luks encryption keys
    "$HOME/Documents/.luks_keys/appdata.raid10/*-keyfile"
    "$HOME/Documents/.luks_keys/cctv.raid10/*-keyfile"
    "$HOME/Documents/.luks_keys/nvme/*-keyfile"

    # ssh public keys
    "$HOME/.ssh/*_rick-root.pub"
    "$HOME/.ssh/*_rick-core.pub"
)

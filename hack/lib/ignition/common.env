# shellcheck shell=bash

# declare -r __ignition_common_sourced="true"
declare -r __ignition_common_lib_sourced="true"

if [ "${__bash_utils_base_config_logging_sourced:-}" != "true" ]; then
    declare -r __bash_utils_base_config_logging="hack/vendor/bash-utils/lib/base-config-logging.sh"
    [ -f "$__bash_utils_base_config_logging" ] || { printf '%s\n' "failed to find file: $__bash_utils_base_config_logging" >&2; exit 1; }
    # shellcheck source=../../vendor/bash-utils/lib/base-config-logging.sh
    . "$__bash_utils_base_config_logging"
fi

if [ "${__ignition_sourced:-}" != "true" ]; then
    declare -r __ignition_lib="hack/lib/ignition/ignition.sh"
    [ -f "$__ignition_lib" ] || fatal "$ERROR_FILE_NOT_FOUND: $__ignition_lib"
    # shellcheck source=ignition.sh
     . "$__ignition_lib"
fi

if [ "${__ignition_butane_sourced:-}" != "true" ]; then
    declare __ignition_butane_lib="hack/lib/ignition/butane.sh"
    [ -f "$__ignition_butane_lib" ] || fatal "$ERROR_FILE_NOT_FOUND: $__ignition_butane_lib"
    # shellcheck source=butane.sh
    . "$__ignition_butane_lib"
fi

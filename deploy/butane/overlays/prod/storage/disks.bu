# deploy/butane/overlays/prod/storage/disks.bu
#
# Partitions the boot disk and the 8 HDD RAID members for the prod node.
#
# Boot disk (coreos-boot-disk):
#   - Partition 4 (label: root) — 50 GiB, resized from the FCOS default root partition.
#   - Partition 5 (label: var)  — remaining space, used for the encrypted /var filesystem.
#
# Data disks (8 HDDs identified by WWN):
#   Each disk receives a single partition spanning the full disk, typed with the
#   Linux RAID member GUID (CA7D7CCB-...) and labelled appdata_raid10.N_p1.
#   These partitions are assembled into md-appdata by storage/raid.bu.
#
# NOTE: wipe_table and wipe_partition_entry are set for initial provisioning only.
#       Remove these flags before redeploying to avoid data loss.
---
variant: fcos
version: 1.7.0
storage:
  # TODO remove wipe_table: true
  # TODO remove wipe_partition_entry: true
  disks:
  # system
  - device: /dev/disk/by-id/coreos-boot-disk
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: root
        number: 4
        size_mib: 51200 # 50Gi
        resize: true

      - label: var
        number: 5
        size_mib: 0

  # appdata
  - device: /dev/disk/by-id/wwn-0x5000c500e62fb786
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.1_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500e643147a
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.2_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500e642d1f3
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.3_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500c8e4bd14
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.4_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  # cctv
  - device: /dev/disk/by-id/wwn-0x5000c500c8e196b3
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.5_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500c8e37087
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.6_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500c937816a
    # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
    wipe_table: true
    partitions:
      - label: appdata_raid10.7_p1
        number: 1
        size_mib: 0
        type_guid: CA7D7CCB-63ED-4C53-861C-1742536059CC
        # TODO REMOVE THIS AFTER INITIAL BOOTSTRAP RUN!!!
        wipe_partition_entry: true

  - device: /dev/disk/by-id/wwn-0x5000c500c8a40802

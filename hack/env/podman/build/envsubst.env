# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r ENVSUBST_VERSION="ENVSUBST_VERSION"
declare -r ENVSUBST_VERSION="ENVSUBST_VERSION"

# declare -r UBI_VERSION_DEFAULT="ubi10-micro"
#
# References:
declare -r UBI_VERSION_DEFAULT="ubi10-micro"

[ -v UBI_VERSION_OVERRIDE ] && echo "UBI_VERSION_OVERRIDE=${UBI_VERSION_OVERRIDE}"

# TODO troubleshoot why this isn't working
# declare -r ENVSUBST_VERSION_TAG="${UBI_VERSION_OVERRIDE:=${UBI_VERSION_DEFAULT}}"
declare -r ENVSUBST_VERSION_TAG="${UBI_VERSION_OVERRIDE:=${UBI_VERSION_DEFAULT}}"

echo "ENVSUBST_VERSION_TAG=${ENVSUBST_VERSION_TAG}"

# declare -A BUILD_ARGS=(
#   ["$UBI_VERSION"]="$UBI_VERSION_TAG"
# )
#
# An associative array is used for buildargs to allow adding them as options without knowing the keys
# key=BUILDARG
# value=BUILDARG=value
declare -A BUILD_ARGS=(
    ["$ENVSUBST_VERSION"]="$ENVSUBST_VERSION_TAG"
)

# declare -r constants="hack/lib/podman/build/constants.env"
declare -r constants="hack/lib/podman/build/constants.env"

[ -f "$constants" ] || "$(echo "File not found: $constants. Exiting."; exit 1)"

# This is here so that shellcheck can resolve variables within vscode.
# The values are already present in the upper scope when this file is sourced.
# To prevent readonly variables from behind reset causing an error, a known value is checked before sourcing would occur.
#
# shellcheck source=../../../lib/podman/build/constants.env
[ -z "${IMAGE_TAG_LATEST}" ] && . "$constants"

# declare -r IMAGE_TAG_PRIMARY="$MOTION_VERSION_TAG"
#
# Used to set --tag passed to podman build, which should be the app version.
#   * This generic variable is set so that the app version can be set as the final image build tag without knowing what the image is.
#   * This is simpler and safer than using the last value in an array of tags.
#   * Additional tags will be created in later steps.
declare -r IMAGE_TAG_PRIMARY="$ENVSUBST_VERSION_TAG"
echo "IMAGE_TAG_PRIMARY=${IMAGE_TAG_PRIMARY}"

FROM install AS release

ARG MOTION_VERSION_TAG
ARG MOTION_RELEASE_PACKAGE
ARG TZ_COUNTRY
ARG TZ_CITY


LABEL motion.version=${MOTION_VERSION_TAG}
LABEL motion.package-installed=${MOTION_RELEASE_PACKAGE}
LABEL localtime="${TZ_COUNTRY}/${TZ_CITY}"
LABEL gpu.acceleration="intel-media-va-driver-non-free"



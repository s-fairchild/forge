# hack/env/kube-manifests-gen.env
#
# Environment file for generate_kube_manifests
#
# shellcheck shell=bash disable=SC2034

declare -r __env_gen_kub_manifests_sourced="true"

# declare -r __manifest_file_extension=".yaml"
#
declare -r __manifest_file_extension=".yaml"

# declare -a apps=()
#
# apps is populated (via mapfile) with directories found in paths:
#   * pkg/workloads
#   * pkg/operators.
#
declare -a apps=()
mapfile -d '' -t apps < <(find pkg/workloads \
                               pkg/operators \
                               -mindepth 1 \
                               -maxdepth 1 \
                               -type d \
                               -print0)
declare -r apps

# apps_enabled is a list of explicitly enabled kubernetes applications.
# Applications in this array will have manifests built via kustomize.
#
#   * Note: indexes can be unset for disabling specific application builds for specific environments (base, staging, prod, etc...)
#
# declare -a apps_enabled=(
#   #################
#   ### Operators ###
#   #################
#   "example_1"
#   "example_2"
#   "example_3"
#   "etc..."
#
#   #################
#   ### Workloads ###
#   #################
#   "example_1"
#   "example_2"
#   "example_3"
#   "etc..."
#
# )
#
declare -a apps_enabled=(
    #################
    ### Operators ###
    #################
    "cert-manager"
    "coredns-custom"
    "intel-device-plugins-gpu"
    "intel-device-plugins-operator"
    "kube-vip"
    "local-path-provisioner"
    "mariadb-operator"
    "mariadb-operator-crds"
    "node-feature-discovery"
    "traefik-custom"

    #################
    ### Workloads ###
    #################
    "jellyfin"
    "mariadb-cluster"
    "motion"
    # "pihole"
    "v4l2rtspserver"
)

---
variant: fcos
version: 1.7.0
storage:
  files:
    - path: /var/lib/containers/storage/secrets/filedriver/secretsdata.json
      contents:
        source: https://10.50.0.202:8080/secrets/staging-secretsdata.json

    - path: /var/lib/containers/storage/secrets/secrets.json
      contents:
        source: https://10.50.0.202:8080/secrets/staging-secrets.json

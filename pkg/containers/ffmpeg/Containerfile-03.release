ARG IMAGE_REGISTRY
ARG IMAGE_REPOSITORY
ARG IMAGE_TAG
FROM ${IMAGE_REGISTRY}/${IMAGE_REPOSITORY}:${IMAGE_TAG} AS release

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
      DEBIAN_FRONTEND=noninteractive apt-get update \
      && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
      && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
            # FFmpeg required shared libraries
            libxcb1 libxcb-shm0 libasound2t64 libsndio7.0 libsdl2-2.0-0 libxv1 \
            libzimg2 ocl-icd-libopencl1 libvpx9 libwebpmux3 libzvbi0t64 \
            libtwolame0 libx264-164 libx265-199 libxvidcore4 \
            # https://github.com/Intel-Media-SDK/MediaSDK/wiki/Intel-media-stack-on-Ubuntu#available-drivers
            # Intel Media SDK Runtime dependencies
            libmfx-tools libmfx1 \
            # VAAPI Backends
            libva-drm2  libva-glx2 libva-x11-2 \
            # Intel Media SDK Driver
            intel-media-va-driver-non-free

ARG PREFIX

COPY --link --from=builder ${PREFIX}/bin ${PREFIX}/bin
COPY --link --from=builder ${PREFIX}/lib ${PREFIX}/lib

ARG FFMPEG_VERSION
ARG CONFIGURE_GENERAL
ARG CONFIGURE_LICENSE

ARG MAKE_EXCLUDE

LABEL ffmpeg.version=${FFMPEG_VERSION}
LABEL ffmpeg.configure.general=${CONFIGURE_GENERAL}
LABEL ffmpeg.configure.license=${CONFIGURE_LICENSE}

LABEL ffmpeg.make.exclude=${MAKE_EXCLUDE}

ENV LD_LIBRARY_PATH="$PREFIX/lib"

ARG LIBVA_DRIVER_NAME
ENV LIBVA_DRIVER_NAME=${LIBVA_DRIVER_NAME}

ENTRYPOINT [ "ffmpeg" ]

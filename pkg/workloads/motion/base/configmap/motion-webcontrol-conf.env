# pkg/workloads/motion/base/configmap/motion-webcontrol-conf.env
#
# shellcheck shell=sh disable=all
#
# Motion Webcontrol settings.
#   * Reference: https://motion-project.github.io/motionv5_config.html#OptDetail_Webcontrol
#
# All variables are prefixed with WEBCONTROL_ when used in the initContainer envsubst
# Defaults (bash variable substitution) preset in the motion.conf template
# Override these settings by merging changes in motion-webcontrol-conf configmap in overlays
#
# References:
#   * https://motion-project.github.io/motionv5_config.html#OptDetail_Webcontrol
#   * https://motion-project.github.io/motionv5_config.html#webcontrol_authentication
#   * https://motion-project.github.io/motionv5_config.html#webcontrol_auth_method


# https://motion-project.github.io/motionv5_config.html#webcontrol_port
# PORT=80

# https://motion-project.github.io/motionv5_config.html#webcontrol_localhost
# LOCALHOST=on

# https://motion-project.github.io/motionv5_config.html#webcontrol_auth_method
AUTH_METHOD=none

# https://motion-project.github.io/motionv5_config.html#webcontrol_actions
# ACTIONS_MOVIES=off
# ACTIONS_RESTART=off
# ACTIONS_SNAPSHOT=on
# ACTIONS_CONFIG=off
# ACTIONS_PTZ=off

# https://motion-project.github.io/motionv5_config.html#webcontrol_parms
# PARMS=0

# https://motion-project.github.io/motionv5_config.html#webcontrol_lock_attempts
# LOCK_ATTEMPT=5
# https://motion-project.github.io/motionv5_config.html#webcontrol_lock_minutes
# LOCK_MINUTES=10

# # TODO configure ssl certificates and keys in certmanager.
# # Provide the mounted cert and key paths here.
# TLS=on
# CERT=
# KEY=

# hack/lib/constants.env
#
# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r __hack_lib_constants_sourced="true"
#
declare -r __hack_lib_constants_sourced="true"

#################
### Constants ###
#################

# declare -ar __empty_array
#
declare -ar __empty_array

#######################
### File Extensions ###
#######################

# declare -r ENVIRONMENT_FILE_EXTENSION=".env"
#
declare -r ENVIRONMENT_FILE_EXTENSION=".env"

# declare -r BUTANE_FILE_EXTENSION=".bu"
#
declare -r BUTANE_FILE_EXTENSION=".bu"

# declare -r IGNITION_FILE_EXTENSION=".ign"
#
declare -r IGNITION_FILE_EXTENSION=".ign"

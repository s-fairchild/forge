# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT="v0.7.0+rpt20260205"
#
# References:
#   * https://github.com/raspberrypi/libcamera/releases/tag/v0.7.0%2Brpt20260205
#   * https://github.com/raspberrypi/libcamera/tree/v0.7.0%2Brpt20260205
declare -r LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT="v0.7.0+rpt20260205"
echo "LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT=${LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT}"

# declare -r LIBCAMERA_VERSION_GIT_TAG_VALUE="${LIBCAMERA_VERSION_GIT_TAG_OVERRIDE-${LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT}}"
#
# LIBCAMERA_VERSION_GIT_TAG_VALUE can be overridden by setting LIBCAMERA_VERSION_GIT_TAG_OVERRIDE.
declare -r LIBCAMERA_VERSION_GIT_TAG_VALUE="${LIBCAMERA_VERSION_GIT_TAG_OVERRIDE:-${LIBCAMERA_VERSION_GIT_TAG_VALUE_DEFAULT}}"
echo "LIBCAMERA_VERSION_GIT_TAG_VALUE=${LIBCAMERA_VERSION_GIT_TAG_VALUE}"

# declare -r LIBCAMERA_VERSION_TAG_VALUE="${LIBCAMERA_VERSION_GIT_TAG%%+*}"
#
# The libcamera version without the +suffix.
# This is used as a podman image tag, which does not support the '+' character.
declare -r LIBCAMERA_VERSION_TAG_VALUE="${LIBCAMERA_VERSION_GIT_TAG_VALUE%%+*}"
echo "LIBCAMERA_VERSION_TAG_VALUE=$LIBCAMERA_VERSION_TAG_VALUE"

# declare -r LIBCAMERA_VERSION_TAG_KEY="LIBCAMERA_VERSION_TAG_KEY"
#
# podman build-arg constant
# overrides the ARG specified in the argfile.conf
declare -r LIBCAMERA_VERSION_TAG_KEY="LIBCAMERA_VERSION"

# declare -r LIBCAMERA_VERSION_GIT_TAG_KEY="LIBCAMERA_VERSION_GIT_TAG_KEY"
#
# podman build-arg constant
# overrides the ARG specified in the argfile.conf
declare -r LIBCAMERA_VERSION_GIT_TAG_KEY="LIBCAMERA_VERSION_GIT_TAG"

# declare -A BUILD_ARGS=(
#   ["$LIBCAMERA_VERSION_TAG_KEY"]="$LIBCAMERA_VERSION_TAG_VALUE"
#   ["$LIBCAMERA_VERSION_GIT_TAG_KEY"]="$LIBCAMERA_VERSION_GIT_TAG_VALUE"
# )
#
# An associative array is used for buildargs to allow adding them as options without knowing the keys
# key=build-arg, value=build-arg value
declare -A BUILD_ARGS=(
    ["$LIBCAMERA_VERSION_TAG_KEY"]="$LIBCAMERA_VERSION_TAG_VALUE"
    ["$LIBCAMERA_VERSION_GIT_TAG_KEY"]="$LIBCAMERA_VERSION_GIT_TAG_VALUE"
)

# declare -r build_constant="hack/lib/podman/build/constants.env"
declare -r build_constant="hack/lib/podman/build/constants.env"

[ -f "$build_constant" ] || fatal "$build_constant not found"

# This is here so that shellcheck can resolve variables within vscode.
# The values are already present in the upper scope when this file is sourced.
# To prevent readonly variables from beind reset causing an error, a known value is checked before sourcing would occur.
#
# shellcheck source=../../../lib/podman/build/constants.env
[ -z "${IMAGE_TAG_LATEST:-}" ] && . "$build_constant"

# declare -r IMAGE_TAG_PRIMARY="$LIBCAMERA_VERSION_TAG_VALUE"
#
# Used to set --tag passed to podman build, which should be the app version.
#   * This generic variable is set so that the app version can be set as the final image build tag without knowing what the image is.
#   * This is simpler and safer than using the last value in an array of tags.
#   * Additional tags will be created in later steps.
declare -r IMAGE_TAG_PRIMARY="$LIBCAMERA_VERSION_TAG_VALUE"
echo "IMAGE_TAG_PRIMARY=${IMAGE_TAG_PRIMARY}"

# Just to be safe (or pedantic), IMAGE_TAGS should be declared after the pseudo source (constants.env should have already been sourced by now).

# declare -a ADDITIONAL_IMAGE_TAGS=(
#   "${IMAGE_TAG_LATEST}"
# )
#
# All tags are added to an array to allow passing to skopeo all at once
#   * Currently unused. Planned for future use.
# declare -a ADDITIONAL_IMAGE_TAGS=(
    # "${IMAGE_TAG_LATEST}"
# )

# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r __podman_build_constants_sourced="true"
declare -r __podman_build_constants_sourced="true"

# declare -r ARGFILE_CONF="argfile.conf"
declare -r ARGFILE_CONF="argfile.conf"

# declare CONTEXT_CONTAINER_IMAGE="container-image://"
#
# Reference: podman-build(1)
declare CONTEXT_CONTAINER_IMAGE="container-image://"
# declare CONTEXT_CONTAINER_IMAGE_DOCKER_IMAGE="docker-image://"
#
# Reference: podman-build(1)
declare CONTEXT_CONTAINER_IMAGE_DOCKER_IMAGE="docker-image://"
# declare CONTEXT_CONTAINER_IMAGE_DOCKER="docker://"
#
# Reference: podman-build(1)
declare CONTEXT_CONTAINER_IMAGE_DOCKER="docker://"

### Registry constants ###

# declare -r LOCAL_REGISTRY="localhost"
declare -r LOCAL_REGISTRY="localhost"

# declare -r REMOTE_REGISTRY="docker.io"
declare -r REMOTE_REGISTRY="docker.io"

### Repository Constants ###

# declare -r LOCAL_REPOSITORY_NAME="steve51516"
declare -r LOCAL_REPOSITORY_NAME="steve51516"

# declare -r LOCAL_REPOSITORY="${LOCAL_REGISTRY}/${LOCAL_REPOSITORY_NAME}"
declare -r LOCAL_REPOSITORY="${LOCAL_REGISTRY}/${LOCAL_REPOSITORY_NAME}"

# declare -r REMOTE_REPOSITORY="${REMOTE_REGISTRY}/${LOCAL_REPOSITORY_NAME}"
declare -r REMOTE_REPOSITORY="${REMOTE_REGISTRY}/${LOCAL_REPOSITORY_NAME}"

### Image Constants ###
### These must be shared because some builds rely on other images for additional context ###

# declare -r IMAGE_ALARM="archlinuxarm"
declare -r IMAGE_ALARM="archlinuxarm"
# declare -r IMAGE_FFMPEG_RPI="ffmpeg-rpi"
declare -r IMAGE_FFMPEG_RPI="ffmpeg-rpi"
# declare -r IMAGE_FFMPEG="ffmpeg"
declare -r IMAGE_FFMPEG="ffmpeg"
# declare -r IMAGE_MOTION="motion"
declare -r IMAGE_MOTION="motion"
# declare -r IMAGE_LIBCAMERA="libcamera"
declare -r IMAGE_LIBCAMERA="libcamera"
# declare -r IMAGE_RPICAM_APPS="rpicam-apps"
declare -r IMAGE_RPICAM_APPS="rpicam-apps"
# declare -r IMAGE_NETCAT="netcat"
declare -r IMAGE_NETCAT="netcat"

### Common Image Tags ###
### Other image specific tags should be set in the respective image's environment file in hack/env/podman/build ###

# declare -r IMAGE_TAG_LATEST="latest"
declare -r IMAGE_TAG_LATEST="latest"

# declare -r BUILD_ENV_BASE="${PWD}/hack/env/podman/build"
#
# Container Context Environment Files
# Environment files are placed here to configure podman build options
# Each context directory gets it's own respective environment file in this directory.
# The env file name is the context basename.
# The files MUST have a .env extension.
declare -r BUILD_ENV_BASE="${PWD}/hack/env/podman/build"

# deploy/butane/base/secrets-example.env
#
# Template for the secrets.env file consumed by the ignition generation pipeline.
# Copy this file to secrets.env in the same overlay directory and populate it
# before running `make ignition-gen-<overlay>`.
#
# secrets.env is sourced by hack/bin/ignition-gen-main.sh before butane compilation
# begins.  It declares the arrays below, which control which host-side files are
# loaded into the podman secret store so that butane can reference them via
# `local: secrets/<name>` inside .bu files.
#
# shellcheck shell=bash
# shellcheck disable=SC2034

# SECRET_FILES
#
# Array of host file paths or glob patterns to create as podman secrets.
# Each matched file becomes a named podman secret using its basename as the
# secret name.  These secrets are mounted into the butane container at
# $__BUTANE_WORKDIR/files/secrets/ during ignition compilation, making them
# available to butane `contents.local: secrets/<name>` and
# `key_file.local: secrets/<name>` references.
#
# Typical entries:
#   - LUKS keyfiles (gzip-compressed, e.g. var.keyfile.gz, appdata.keyfile.gz)
#   - SSH public keys (e.g. id_ed25519_rick-root.pub, id_ed25519_rick-core.pub)
#
# Secrets that already exist in the podman store are skipped with a warning.
# Delete the secret manually before re-running to force an update.
declare -ar SECRET_FILES=(
    # luks encryption keys
    # "$HOME/Documents/.luks_keys/*.keyfile.gz"
    #
    # ssh public keys
    # "$HOME/.ssh/*_rick-root.pub"
    # "$HOME/.ssh/*_rick-core.pub"
)

# SECRET_IDS
#
# Array of existing podman secret names or IDs to include in the ignition
# generation run without creating new secrets from files.  Use this to pass
# secrets that were created separately (e.g. by hack/bin/k3s-tokens-generate.sh)
# into the butane container alongside those created from SECRET_FILES.
#
# Accepts either the full 25-character secret ID or the human-readable name.
declare -ar SECRET_IDS=(
    # "k3s-token"
    # "k3s-agent-token"
    # "a45f0f4902ea2d60fa81e3011"
)

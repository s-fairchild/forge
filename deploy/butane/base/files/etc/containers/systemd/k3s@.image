[Unit]
Description=Pull image docker.io/rancher/k3s:${K3S_IMAGE_TAG}
Documentation=https://docs.k3s.io/advanced?_highlight=docker#running-k3s-in-docker https://hub.docker.com/r/rancher/k3s
Requisite=nss-lookup.target
After=nss-lookup.target
ConditionEnvironment=K3S_IMAGE_TAG

[Service]
EnvironmentFile=/usr/local/etc/sysconfig/%N
TimeoutStartSec=900

[Image]
# One week with --retry-delay=1m
Retry=10080
RetryDelay=1m
Image=docker.io/rancher/k3s:${K3S_IMAGE_TAG}

[Install]
WantedBy=default.target

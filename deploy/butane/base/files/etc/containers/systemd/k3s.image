[Unit]
Description=Pull image docker.io/rancher/k3s:${IMAGE_TAG_K3S}
Requisite=nss-lookup.target
After=nss-lookup.target

[Service]
EnvironmentFile=-/usr/local/etc/sysconfig/%N
TimeoutStartSec=900

[Image]
# One week with --retry-delay=1m
Retry=10080
RetryDelay=1m

[Install]
WantedBy=default.target

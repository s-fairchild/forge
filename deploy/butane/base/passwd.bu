---
variant: fcos
version: 1.5.0
passwd:
  users:
    - name: localpath
      uid: 511
      gecos: localpath Kubernetes Volume Provisioner System User
      no_create_home: true
      shell: /sbin/nologin
      system: true

    - name: jellyfin
      uid: 911
      gecos: Jellyfin App System User
      no_create_home: true
      groups:
        - video
        - render
      shell: /sbin/nologin
      system: true

storage:
  directories:
    - path: /root/.bashrc.d
      overwrite: true

  trees:
    - path: /root/.bashrc.d
      local: root/bashrc.d

---
variant: fcos
version: 1.5.0
systemd:
  units:
  - name: podman.socket
    enabled: true

storage:
  files:
  - path: /etc/containers/storage.conf
    overwrite: true
    contents:
      local: containers/storage.conf

  directories:
  - path: /etc/containers/containers.conf.d
    overwrite: true

  - path: /etc/containers/systemd
    overwrite: true

  trees:
  - path: /etc/containers
    local: containers/containers.conf.d

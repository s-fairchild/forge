# shellcheck disable=SC2148

# SUBVOLUMES
# Associative array containing the subvolume name (key) and it's mount point (value)
declare -Arx SUBVOLUMES=(
    ['@']="@"
    ["@snapshots"]=".snapshots"
    ["@var"]="var"
    ["@var_lib_containers"]="var/lib/containers"
    ["@var_cache_pacman_pkg"]="var/cache/pacman/pkg"
    ["@opt"]="opt"
    ["@root_home"]="root"
    ["@home"]="home"
    ["@usr_local"]="usr/local"
)

# SUBVOLUME_MOUNT_ORDER
# An array that is indexed in the order the subvolumes are required to be mounted in
declare -arx SUBVOLUME_MOUNT_ORDER=(
    "@"
    "@snapshots"
    "@var"
    "@var_lib_containers"
    "@var_cache_pacman_pkg"
    "@opt"
    "@root_home"
    "@home"
    "@usr_local"
)

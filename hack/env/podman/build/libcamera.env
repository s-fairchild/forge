# shellcheck shell=bash
# shellcheck disable=SC2034

# declare -r LIBCAMERA_VERSION="LIBCAMERA_VERSION"
#
# podman build-arg constant
# overrides the ARG specified in the argfile.conf
declare -r LIBCAMERA_VERSION="LIBCAMERA_VERSION"

# declare -r LIBCAMERA_VERSION_GIT="LIBCAMERA_VERSION_GIT"
#
# podman build-arg constant
# overrides the ARG specified in the argfile.conf
declare -r LIBCAMERA_VERSION_GIT="LIBCAMERA_VERSION_GIT"

# declare -r LIBCAMERA_VERSION_v0_6_0="v0.6.0+rpt20251202"
# podman build arg value constant
#
# References:
#   * https://github.com/raspberrypi/libcamera/releases/tag/v0.6.0%2Brpt20251202
#   * https://github.com/raspberrypi/libcamera/tree/v0.6.0%2Brpt20251202
declare -r LIBCAMERA_VERSION_GIT_v0_6_0="v0.6.0+rpt20251202"

# declare -r LIBCAMERA_VERSION_v0_6_0="${LIBCAMERA_VERSION_v0_6_0%%+*}"
#
# The libcamera version without the +suffix
declare -r LIBCAMERA_VERSION_v0_6_0="${LIBCAMERA_VERSION_GIT_v0_6_0%%+*}"

# declare -A BUILDARGS=(
#   ["$LIBCAMERA_VERSION"]="$LIBCAMERA_VERSION_v0_6_0"
#   ["$LIBCAMERA_VERSION_GIT"]="$LIBCAMERA_VERSION_GIT_v0_6_0"
# )
#
# An associative array is used for buildargs to allow adding them as options without knowing the keys
# key=build-arg, value=build-arg value
#
# References:
#   * https://github.com/raspberrypi/libcamera/releases/tag/v0.6.0%2Brpt20251202
#   * https://github.com/raspberrypi/libcamera/tree/v0.6.0%2Brpt20251202
declare -A BUILD_ARGS=(
    ["$LIBCAMERA_VERSION"]="$LIBCAMERA_VERSION_v0_6_0"
    ["$LIBCAMERA_VERSION_GIT"]="$LIBCAMERA_VERSION_GIT_v0_6_0"
)

# declare -r constants="hack/lib/podman/build/constants.env"
declare -r constants="hack/lib/podman/build/constants.env"
[ -f "$constants" ] || "$(echo "File not found: $constants. Exiting."; exit 1)"

# This is here so that shellcheck can resolve variables within vscode.
# The values are already present in the upper scope when this file is sourced.
# To prevent readonly variables from beind reset causing an error, a known value is checked before sourcing would occur.
if [ -z "${TAG_IMAGE_LATEST:-}" ]; then
    # shellcheck source=../../../lib/podman/build/constants.env
    source "$constants"
fi

# For correctness sake, IMAGE_TAGS should be declared after the pseudo source

# declare -a IMAGE_TAGS=(
#   "$IMAGE_TAG_LATEST"
#   "$LIBCAMERA_VERSION_v0_6_0"
# )
#
# All tags are added to an array to allow passing to skopeo all at once
declare -a IMAGE_TAGS=(
    "${TAG_IMAGE_LATEST}"
    # + is invalid in an image tag
    "${LIBCAMERA_VERSION_v0_6_0}"
)

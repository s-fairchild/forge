---
variant: fcos
version: 1.5.0
systemd:
  units:
    ####################
    ###   Services   ###
    ####################
    - name: btrfs-scrub.service
      contents_local: vendor/btrfsmaintenance/btrfs-scrub.service

    - name: btrfs-defrag.service
      contents_local: vendor/btrfsmaintenance/btrfs-defrag.service

    - name: btrfs-balance.service
      contents_local: vendor/btrfsmaintenance/btrfs-balance.service

    - name: btrfs-trim.service
      contents_local: vendor/btrfsmaintenance/btrfs-trim.service

    - name: btrfsmaintenance-refresh.service
      contents_local: vendor/btrfsmaintenance/btrfsmaintenance-refresh.service

    - name: btrfsmaintenance-refresh.path
      contents_local: vendor/btrfsmaintenance/btrfsmaintenance-refresh.path

    ##################
    ###   Timers   ###
    ##################
    - name: btrfs-scrub.timer
      enabled: false
      contents_local: vendor/btrfsmaintenance/btrfs-scrub.timer

    - name: btrfs-defrag.timer
      enabled: false
      contents_local: vendor/btrfsmaintenance/btrfs-defrag.timer

    - name: btrfs-balance.timer
      enabled: false
      contents_local: vendor/btrfsmaintenance/btrfs-balance.timer

    - name: btrfs-trim.timer
      enabled: false
      contents_local: vendor/btrfsmaintenance/btrfs-trim.timer

storage:
  files:
    #########################
    ###   Configuration   ###
    #########################
    - path: /etc/sysconfig/btrfsmaintenance
      overwrite: true
      contents:
        local: vendor/btrfsmaintenance/sysconfig.btrfsmaintenance

    ####################
    ###   Binaries   ###
    ####################
    - path: /usr/share/btrfsmaintenance/btrfsmaintenance-functions
      overwrite: true
      mode: 0440
      contents:
        local: vendor/btrfsmaintenance/btrfsmaintenance-functions

    - path: /usr/share/btrfsmaintenance/btrfsmaintenance-refresh-cron.sh
      overwrite: true
      mode: 0544
      contents:
        local: vendor/btrfsmaintenance/btrfsmaintenance-refresh-cron.sh

    - path: /usr/share/btrfsmaintenance/btrfs-balance.sh
      overwrite: true
      mode: 0544
      contents:
        local: vendor/btrfsmaintenance/btrfs-balance.sh

    - path: /usr/share/btrfsmaintenance/btrfs-defrag.sh
      overwrite: true
      mode: 0544
      contents:
        local: vendor/btrfsmaintenance/btrfs-defrag.sh

    - path: /usr/share/btrfsmaintenance/btrfs-scrub.sh
      overwrite: true
      mode: 0544
      contents:
        local: vendor/btrfsmaintenance/btrfs-scrub.sh

    - path: /usr/share/btrfsmaintenance/btrfs-trim.sh
      overwrite: true
      mode: 0544
      contents:
        local: vendor/btrfsmaintenance/btrfs-trim.sh

    #########################
    ###   Documentation   ###
    #########################
    - path: /usr/local/share/doc/btrfsmaintenance/README.man
      overwrite: true
      contents:
        local: vendor/btrfsmaintenance/README.man

  links:
    - path: /usr/local/share/doc/packages/btrfsmaintenance/README.man
      overwrite: true
      target: /usr/local/share/doc/btrfsmaintenance/README.man

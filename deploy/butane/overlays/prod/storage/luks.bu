# deploy/butane/overlays/prod/storage/luks.bu
#
# Configures LUKS2 encryption for the three prod storage volumes.
#
#   root    — /dev/disk/by-partlabel/root (boot disk p4, 50 GiB)
#               TPM2 clevis binding only; automatically unlocked at boot via
#               the TPM2 PCR policy without a passphrase or keyfile.
#
#   var     — /dev/disk/by-partlabel/var (boot disk p5, remaining space)
#               Keyfile unlock using secrets/var.keyfile.gz (gzip-compressed).
#               TPM2 binding is commented out pending TPM2 enablement on the host.
#               Hosts the encrypted /var btrfs filesystem.
#
#   appdata — /dev/md/md-appdata (RAID10 array assembled by storage/raid.bu)
#               Keyfile secrets/appdata.keyfile.gz.
#               Hosts the encrypted /mnt/appdata btrfs filesystem for workload storage.
#
# The keyfiles are injected into the butane container as podman secrets from
# SECRET_FILES in deploy/butane/overlays/prod/secrets.env during ignition generation.
# sha512 verification hashes guard against accidental keyfile substitution.
---
variant: fcos
version: 1.7.0
storage:
  luks:
    - name: root
      device: /dev/disk/by-partlabel/root
      clevis:
        tpm2: true
      wipe_volume: true
      discard: true

    - name: var
      label: var_luks
      device: /dev/disk/by-partlabel/var
      key_file:
        source: https://10.50.0.202:8080/secrets/var.keyfile.gz
        compression: gzip
        verification: 
          hash: sha512-3263a7f20a3ef1daf48dae9ef2a3f19700fc7ebb8d7673edce4022af26d2f38040078bb9329459af9d8f1b9a57faf91f97ddce4b20224fe4c7b6d14908b8e145
      wipe_volume: true
      discard: true

    - name: appdata
      label: appdata_luks
      device: /dev/md/md-appdata
      key_file:
        source: https://10.50.0.202:8080/secrets/appdata.keyfile.gz
        compression: gzip
        verification: 
          hash: sha512-0d7380a227af7b8c6e11bf3f7d2cced99fec8ecc00decb3e559a0cfe9c7151e0744c129ed6fb2dfc6df0b43d9a3921858cfb27a336f59c1df568c40f2efbf06f
      wipe_volume: true

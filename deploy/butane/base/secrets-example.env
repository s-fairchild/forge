# deploy/butane/overlays/prod/secrets-example.env
#
# shellcheck shell=bash
# shellcheck disable=SC2034

# Array of file(s) to be created as podman secrets for butane config local secrets
#
# Either direct file paths or file glob patterns can be specified
declare -ar SECRET_KEYS=(
    # Example config
    #
    # luks encryption keys
    # "$HOME/super-secret/luks.keyfile.gz"
    #
    # ssh public keys
    # "$HOME/.ssh/*.pub"
    #
    # etc...
)
